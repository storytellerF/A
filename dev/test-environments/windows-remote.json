{
  "version": 1,
  "workspace": "../..",
  "environment": {
    "APPIUM_DESKTOP_PLATFORM": "Windows"
  },
  "appium": {
    "cleanup_roots": [
      "app/desktopAppium/build/test/appium/private",
      "panel/desktopAppium/build/test/appium/private"
    ],
    "launch": {
      "kind": "java-argfile",
      "inputs": [
        "appium.session.file"
      ],
      "outputs": [
        "appium.desktop.pid.file",
        "appium.desktop.log"
      ],
      "directories": [
        "java.util.prefs.userRoot",
        "app.protected.storage.dir",
        "appium.desktop.tmpdir"
      ],
      "services": [
        "appium.server.url",
        "appium.ws.url",
        "appium.filesystem.url"
      ]
    }
  },
  "requirements": "desktop-requirements.json"
}
