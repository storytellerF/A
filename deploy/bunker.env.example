# Copy outside the repository to ~/deploy/bunker.env.
# Replace every example domain and credential before deployment.
# These are final BunkerWeb names, not Compose interpolation variables.
# Values are literal; do not add quotes unless they belong in the value.
# FILESYSTEM_PUBLIC_URL belongs in deploy/{flavor}.env, not this file.
SERVER_NAME=ui.example.com api.example.com media.example.com adminer.example.com grafana.example.com app.example.com panel.example.com
EMAIL_LETS_ENCRYPT=admin@example.com
ADMIN_USERNAME=change-admin
ADMIN_PASSWORD=change-password
ui.example.com_USE_UI=yes
ui.example.com_REVERSE_PROXY_HOST=http://localhost:7000
ui.example.com_MAX_CLIENT_SIZE=50m
ui.example.com_REVERSE_PROXY_URL=/etasuhe
api.example.com_REVERSE_PROXY_URL=/
api.example.com_REVERSE_PROXY_HOST=http://server:80
api.example.com_REVERSE_PROXY_URL_1=/ws
api.example.com_REVERSE_PROXY_HOST_1=http://ws:80
api.example.com_REVERSE_PROXY_WS_1=yes
api.example.com_REVERSE_PROXY_READ_TIMEOUT_1=15m
api.example.com_REVERSE_PROXY_SEND_TIMEOUT_1=15m
api.example.com_REVERSE_PROXY_INTERCEPT_ERRORS=no
api.example.com_INTERCEPTED_ERROR_CODES=
api.example.com_ALLOWED_METHODS=GET|POST|DELETE|HEAD|OPTIONS
api.example.com_USE_CORS=yes
api.example.com_CORS_ALLOW_ORIGIN=^https://(app|panel)\.example\.com$
api.example.com_CORS_ALLOW_METHODS=GET, POST, DELETE, OPTIONS
# Keep X-Account-Id when upgrading: credentialed App/Panel requests use it to match the Cookie account.
api.example.com_CORS_ALLOW_HEADERS=DNT,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Range,Authorization,a-ts,X-Request-ID,X-Account-Id
api.example.com_CORS_ALLOW_CREDENTIALS=yes
api.example.com_CORS_EXPOSE_HEADERS=Content-Length,Content-Range,WWW-Authenticate
api.example.com_CORS_DENY_REQUEST=yes
api.example.com_CUSTOM_HEADER=Access-Control-Allow-Credentials: true
media.example.com_REVERSE_PROXY_HOST=http://filesystem:8822
media.example.com_REVERSE_PROXY_URL=/objects/
media.example.com_REVERSE_PROXY_INTERCEPT_ERRORS=no
media.example.com_INTERCEPTED_ERROR_CODES=
media.example.com_ALLOWED_METHODS=GET|HEAD|OPTIONS
media.example.com_USE_CORS=yes
media.example.com_CORS_ALLOW_ORIGIN=^https://(app|panel)\.example\.com$
media.example.com_CORS_ALLOW_METHODS=GET, POST, DELETE, OPTIONS
media.example.com_CORS_ALLOW_HEADERS=DNT,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Range,Authorization,a-ts,X-Request-ID
media.example.com_CORS_ALLOW_CREDENTIALS=no
media.example.com_CORS_DENY_REQUEST=yes
media.example.com_CUSTOM_HEADER=Cross-Origin-Resource-Policy: same-site
adminer.example.com_REVERSE_PROXY_HOST=http://adminer:8080
adminer.example.com_REVERSE_PROXY_URL=~ ^/
adminer.example.com_REVERSE_PROXY_INTERCEPT_ERRORS=no
adminer.example.com_INTERCEPTED_ERROR_CODES=
adminer.example.com_ALLOWED_METHODS=GET|POST|DELETE|HEAD|OPTIONS
grafana.example.com_REVERSE_PROXY_HOST=http://grafana:3000
grafana.example.com_REVERSE_PROXY_INTERCEPT_ERRORS=no
grafana.example.com_INTERCEPTED_ERROR_CODES=
grafana.example.com_ALLOWED_METHODS=GET|POST|DELETE|HEAD|OPTIONS
app.example.com_REVERSE_PROXY_HOST=http://app-wasm:80
app.example.com_REVERSE_PROXY_INTERCEPT_ERRORS=no
app.example.com_INTERCEPTED_ERROR_CODES=
app.example.com_ALLOWED_METHODS=GET|HEAD|OPTIONS
app.example.com_PERMISSIONS_POLICY=accelerometer=(), ambient-light-sensor=(), attribution-reporting=(), autoplay=(), bluetooth=(), browsing-topics=(), camera=(), compute-pressure=(), display-capture=(), encrypted-media=(), fullscreen=(), geolocation=(), gyroscope=(), hid=(), identity-credentials-get=(), idle-detection=(), local-fonts=(self), magnetometer=(), microphone=(), midi=(), otp-credentials=(), payment=(), picture-in-picture=(), publickey-credentials-create=(), publickey-credentials-get=(), screen-wake-lock=(), serial=(), storage-access=(), usb=(), web-share=(), window-management=(), xr-spatial-tracking=(), aria-notify=(), captured-surface-control=(), cross-origin-isolated=(self), deferred-fetch=(), deferred-fetch-minimal=(), on-device-speech-recognition=(), summarizer=(), wildcards=(), private-state-token-issuance=(), private-state-token-redemption=(), ch-ua-high-entropy-values=(), gamepad=(), local-network=(), local-network-access=(), loopback-network=(), interest-cohort=()
panel.example.com_REVERSE_PROXY_HOST=http://panel-wasm:80
panel.example.com_REVERSE_PROXY_INTERCEPT_ERRORS=no
panel.example.com_INTERCEPTED_ERROR_CODES=
panel.example.com_ALLOWED_METHODS=GET|HEAD|OPTIONS
panel.example.com_PERMISSIONS_POLICY=accelerometer=(), ambient-light-sensor=(), attribution-reporting=(), autoplay=(), bluetooth=(), browsing-topics=(), camera=(), compute-pressure=(), display-capture=(), encrypted-media=(), fullscreen=(), geolocation=(), gyroscope=(), hid=(), identity-credentials-get=(), idle-detection=(), local-fonts=(self), magnetometer=(), microphone=(), midi=(), otp-credentials=(), payment=(), picture-in-picture=(), publickey-credentials-create=(), publickey-credentials-get=(), screen-wake-lock=(), serial=(), storage-access=(), usb=(), web-share=(), window-management=(), xr-spatial-tracking=(), aria-notify=(), captured-surface-control=(), cross-origin-isolated=(self), deferred-fetch=(), deferred-fetch-minimal=(), on-device-speech-recognition=(), summarizer=(), wildcards=(), private-state-token-issuance=(), private-state-token-redemption=(), ch-ua-high-entropy-values=(), gamepad=(), local-network=(), local-network-access=(), loopback-network=(), interest-cohort=()
