BUILD_TYPE=dev
FLAVOR=sample
BUILD_ON=local
COMPOSE_PROJECT_NAME=a-sample
COMPOSE_FILE_LIST=pg,elastic,minio,cli,server,sample

SEARCH_SERVICE=elastic
LUCENE_BASE_PATH=../../deploy/lucene_data
ELASTIC_VERSION=8.17.2
ELASTIC_CLUSTER_NAME=docker-cluster
ELASTIC_LICENSE=basic
ELASTIC_URL=https://es01:9200
ELASTIC_PORT=9200
ELASTIC_CERT_DIR=../es_ca
ELASTIC_CERT_FILE=/app/deploy/es_ca/ca/ca.crt
ELASTIC_NAME=elastic
ELASTIC_PASSWORD=elastic
KIBANA_PORT=5601
KIBANA_PASSWORD=kibana
KIBANA_ENCRYPTION_KEY=c34d38b3a2c54554e71a7433e1d3c824

MEDIA_SERVICE=minio
MINIO_URL=http://minio:9000
MINIO_HOST=http://localhost:9000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_NAME=minioadmin
MINIO_PASS=minioadmin

DATABASE_URI=r2dbc:postgresql://pg:5432/A
DATABASE_PORT=5432
DATABASE_DB=A
DATABASE_DRIVER=postgresql
DATABASE_USER=A
DATABASE_PASS=PASS
DATABASE_FRONT_PORT=8812

SERVER_PORT=8811
SERVER_EXPOSE_PORT=8811
SERVER_URL=http://localhost:8811
WS_SERVER_PORT=8813
WS_SERVER_EXPOSE_PORT=8813
WS_SERVER_URL=ws://localhost:8813
WS_RPC_URL=ws://localhost:8813/rpc
APP_WASM_PORT=8080

PRESET_PATH=../dev-data
CLI_INIT_ENABLE=true
CLI_READY_PORT=8081
SESSION_SECRET=a-sample-session-secret-change-me
ENABLE_SIGN_UP=true
app.DEBUG=true
